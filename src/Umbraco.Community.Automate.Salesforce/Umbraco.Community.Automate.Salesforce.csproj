<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- Razor SDK RCL — same single-project shape as Umbraco.Automate.Slack. Holds Actions/,
         Connection/, and Configuration/. The single NuGet package an implementer installs — no
         meta-package, no persistence split, since this package ships no triggers and keeps no
         local state (every action calls the Salesforce REST API directly and stores nothing
         itself; there is no Describe-metadata cache — see docs/dev-notes.md §5). -->
    <PropertyGroup>
        <Title>Umbraco Automate Salesforce</Title>
        <Description>Salesforce connection and actions for Umbraco Automate</Description>
        <PackageReadmeFile>docs\README.md</PackageReadmeFile>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <StaticWebAssetBasePath>App_Plugins/UmbracoCommunityAutomateSalesforce</StaticWebAssetBasePath>
        <!-- Razor SDK auto-includes root-level JSON as Content, which collides with the
             explicit include of the generated appsettings-schema JSON below (mirrors Slack). -->
        <EnableDefaultContentItems>false</EnableDefaultContentItems>
        <!-- Class library (non-Web-SDK) projects don't copy transitive PackageReference DLLs to
             their own bin output by default — only executable/Web projects do. GenerateAppsettingsSchema
             below reflection-loads $(TargetPath) via JsonSchemaGenerate, which needs
             Umbraco.Automate.OpenIddict.Core.dll (referenced by UmbracoCommunityAutomateSalesforceSchema.cs)
             sitting right next to it to resolve. Found by actually building with
             -p:UseProjectReferences=false (real NuGet packages, not project references, which
             always copy transitively) — ProjectReference mode never exercises this because project
             references DO copy transitively, masking the gap in local/dev builds. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="docs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenIddict.Client.WebIntegration" />
    </ItemGroup>

    <!-- Sibling-monorepo dev mode: resolves against a local ../../../Umbraco.Automate checkout
         (see root README "Repository home"). That's a clone of the *whole* umbraco/Umbraco.Automate
         monorepo (not just the Core product) — Core and OpenIddict each live one level further
         in, under their own like-named product folders within it, exactly as in the real repo
         (confirm this nesting against the actual clone before "fixing" it again if it ever looks
         wrong — it tripped up this exact path once already). Falls back to NuGet PackageReference
         below when that checkout isn't present, so a fresh clone of this repo alone still builds. -->
    <ItemGroup Condition="'$(UseProjectReferences)' == 'true' AND Exists('..\..\..\Umbraco.Automate\Umbraco.Automate\src\Umbraco.Automate.Core\Umbraco.Automate.Core.csproj')">
        <ProjectReference Include="..\..\..\Umbraco.Automate\Umbraco.Automate\src\Umbraco.Automate.Core\Umbraco.Automate.Core.csproj" />
        <ProjectReference Include="..\..\..\Umbraco.Automate\Umbraco.Automate.OpenIddict\src\Umbraco.Automate.OpenIddict\Umbraco.Automate.OpenIddict.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' != 'true' OR !Exists('..\..\..\Umbraco.Automate\Umbraco.Automate\src\Umbraco.Automate.Core\Umbraco.Automate.Core.csproj')">
        <PackageReference Include="Umbraco.Automate.Core" />
        <PackageReference Include="Umbraco.Automate.OpenIddict" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Umbraco.Community.Automate.Salesforce.Tests.Unit</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Umbraco.Community.Automate.Salesforce.Tests.Integration</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Ship buildTransitive props so consuming sites' CopyUmbracoJsonSchemaFiles target
         (from Umbraco.Cms.Targets) discovers the schema and copies it into the project —
         mirrors Umbraco.Automate.Slack's Umbraco.Automate.Slack.csproj exactly. -->
    <ItemGroup>
        <Content Include="buildTransitive\**" PackagePath="buildTransitive" />
    </ItemGroup>

    <!-- Add JSON schema file to package output -->
    <PropertyGroup>
        <_UmbracoCommunityAutomateSalesforceJsonSchemaReference>appsettings-schema.Umbraco.Community.Automate.Salesforce.json</_UmbracoCommunityAutomateSalesforceJsonSchemaReference>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="$(_UmbracoCommunityAutomateSalesforceJsonSchemaReference)" PackagePath="" Visible="false" />
        <Clean Include="$(_UmbracoCommunityAutomateSalesforceJsonSchemaReference)" />
    </ItemGroup>

    <!-- Generate JSON schema on build (and before copying to project) -->
    <Target Name="GenerateAppsettingsSchema" BeforeTargets="Build;CopyUmbracoJsonSchemaFiles" Inputs="$(TargetPath)" Outputs="$(_UmbracoCommunityAutomateSalesforceJsonSchemaReference)">
        <Message Text="Generating $(_UmbracoCommunityAutomateSalesforceJsonSchemaReference)" Importance="high" />
        <JsonSchemaGenerate AssemblyPath="$(TargetPath)" TypeName="UmbracoCommunityAutomateSalesforceSchema" OutputPath="$(_UmbracoCommunityAutomateSalesforceJsonSchemaReference)" IncludeObsoleteProperties="false" />
        <ItemGroup>
            <FileWrites Include="$(_UmbracoCommunityAutomateSalesforceJsonSchemaReference)" />
        </ItemGroup>
    </Target>

</Project>
