{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "UmbracoAutomateSalesforceSchema",
  "type": "object",
  "properties": {
    "Umbraco": {
      "description": "Configuration container for all Umbraco products.",
      "oneOf": [
        {
          "$ref": "#/definitions/UmbracoDefinition"
        }
      ]
    }
  },
  "definitions": {
    "UmbracoDefinition": {
      "type": "object",
      "properties": {
        "Automate": {
          "description": "Configuration of Umbraco Automate.",
          "oneOf": [
            {
              "$ref": "#/definitions/UmbracoAutomateDefinition"
            }
          ]
        }
      }
    },
    "UmbracoAutomateDefinition": {
      "type": "object",
      "properties": {
        "Providers": {
          "description": "OAuth provider credentials, keyed by provider name.",
          "oneOf": [
            {
              "$ref": "#/definitions/ProvidersDefinition"
            }
          ]
        },
        "Salesforce": {
          "description": "Salesforce REST API call behaviour — distinct from the OAuth app credentials above.",
          "oneOf": [
            {
              "$ref": "#/definitions/SalesforceApiDefinition"
            }
          ]
        }
      }
    },
    "ProvidersDefinition": {
      "type": "object",
      "properties": {
        "Salesforce": {
          "description": "Salesforce OAuth app credentials and scope configuration\n(issuer https://login.salesforce.com/).",
          "oneOf": [
            {
              "$ref": "#/definitions/OAuthProviderConfiguration"
            }
          ]
        }
      }
    },
    "OAuthProviderConfiguration": {
      "type": "object",
      "properties": {
        "ClientId": {
          "type": [
            "null",
            "string"
          ]
        },
        "ClientSecret": {
          "type": [
            "null",
            "string"
          ]
        },
        "Scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SalesforceApiDefinition": {
      "type": "object",
      "description": "Salesforce API call behaviour section (Umbraco:Automate:Salesforce).",
      "properties": {
        "ApiVersion": {
          "type": "string",
          "description": "Gets or sets the Salesforce REST API version to call, e.g. \"v62.0\"."
        },
        "MaxRetryAttempts": {
          "type": "integer",
          "description": "Gets or sets the maximum number of retry attempts on a rate-limited response before\nthe action fails, after the first (non-retry) attempt.",
          "format": "int32"
        },
        "MaxRetryDelay": {
          "type": "string",
          "description": "Gets or sets the ceiling on how long a single retry delay is allowed to grow to.",
          "format": "duration"
        }
      }
    }
  }
}