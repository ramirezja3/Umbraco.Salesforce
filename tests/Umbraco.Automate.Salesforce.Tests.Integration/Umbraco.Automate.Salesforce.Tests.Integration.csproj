<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="coverlet.collector" />
        <!-- Add a WireMock.Net (or equivalent) PackageReference here once the fixture layer for
             recorded Salesforce REST API responses is designed — see docs/dev-notes.md §9 and confirm
             against whatever fixture approach Slack/OpenIddict's own integration tests use. -->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Umbraco.Automate.Salesforce\Umbraco.Automate.Salesforce.csproj" />
    </ItemGroup>

    <!-- Umbraco.Automate.Testing's ActionTestHarness lets the live-org tests execute real Action
         classes with a real ConfiguredConnection — same sibling-checkout-with-NuGet-fallback
         pattern as the src project's own Core/OpenIddict references. -->
    <PropertyGroup>
        <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
    </PropertyGroup>
    <ItemGroup Condition="'$(UseProjectReferences)' == 'true' AND Exists('..\..\..\Umbraco.Automate\Umbraco.Automate\src\Umbraco.Automate.Testing\Umbraco.Automate.Testing.csproj')">
        <ProjectReference Include="..\..\..\Umbraco.Automate\Umbraco.Automate\src\Umbraco.Automate.Testing\Umbraco.Automate.Testing.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseProjectReferences)' != 'true' OR !Exists('..\..\..\Umbraco.Automate\Umbraco.Automate\src\Umbraco.Automate.Testing\Umbraco.Automate.Testing.csproj')">
        <PackageReference Include="Umbraco.Automate.Testing" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="Shouldly" />
        <Using Include="Moq" />
    </ItemGroup>

</Project>
