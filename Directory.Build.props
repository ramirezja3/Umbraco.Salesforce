<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>ramirezja3</Authors>
    <Copyright>Copyright © ramirezja3 $([System.DateTime]::Today.ToString('yyyy'))</Copyright>
    <Product>Automate Salesforce Connector</Product>
    <!-- Umbraco.Automate.Slack's own PackageProjectUrl points at wherever its real current git
         home is (a folder within the umbraco/Umbraco.Automate monorepo, since that's where it
         actually lives) — mirroring that pattern, not Slack's literal URL: this repo's real
         current home is standalone, so this points there. Update if/when that changes (e.g. if
         this package is ever folded into the official monorepo, which is a separate decision
         requiring Umbraco HQ's own acceptance via their contribution process — not something to
         do unilaterally by moving files). -->
    <PackageProjectUrl>https://github.com/ramirezja3/Umbraco.Salesforce</PackageProjectUrl>
    <PackageIcon>logo-128.png</PackageIcon>
    <PackageTags>umbraco automate automation salesforce crm umbraco-marketplace</PackageTags>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet -->
  <PropertyGroup>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <!-- SourceLink -->
  <PropertyGroup>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Package validation -->
  <PropertyGroup>
    <GenerateCompatibilitySuppressionFile>false</GenerateCompatibilitySuppressionFile>
    <EnablePackageValidation>false</EnablePackageValidation>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
  </PropertyGroup>

  <!-- LICENSE and the package icon are packed the same way Umbraco.Automate.Slack's
       Directory.Build.props packs them (its paths there are "..\LICENSE" / "..\assets\logo-128.png"
       because Slack's Directory.Build.props lives one level down inside the monorepo; this repo's
       Directory.Build.props is at the repo root itself, hence no "..\"). The icon is a generic
       CRM/contact-record motif in this ecosystem's shared navy/pink palette — deliberately not a
       Salesforce logo, to avoid implying Salesforce endorsement or reproducing their trademark. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <Content Include="$(MSBuildThisFileDirectory)assets\logo-128.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <GitVersionBaseDirectory>$(MSBuildThisFileDirectory)</GitVersionBaseDirectory>
  </PropertyGroup>
</Project>
